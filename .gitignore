# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (any level — app + sdk)
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# build output
/.next/
/out/
/build
dist/
brag-output

# testing
/coverage
/test/

# misc
.DS_Store
*.pem

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (never commit secrets)
.env
.env.*
!.env.example

# vercel
.vercel

# typescript / next
*.tsbuildinfo
next-env.d.ts
